NODE_ENV=production
PORT=5000

# Database (MySQL)
DB_HOST=your-db-host.example.com
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password
DB_NAME=your_db_name

# JWT — MUST be a long, random, secret string (min 64 chars)
JWT_SECRET=replace-with-64-char-random-secret-generated-by-openssl-rand-hex-32

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Redis (e.g. RedisLabs / Upstash)
REDIS_URL=redis://default:password@host:port

# FTP (for file uploads to Hostinger)
FTP_HOST=your-ftp-host
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password

# Admin seeding — set these before first deploy to production
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=strong-unique-admin-password-min-16-chars

# CORS — Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
